---
version: "3"
services:
  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    ports:
      - 6881:6881
      - 6881:6881/udp
      - 8085:8085
      - 5055:5055
      - 8989:8989
      - 9696:9696
      - 7878:7878
    volumes:
      - /docker/arr-stack:/gluetun
    environment:
      - VPN_SERVICE_PROVIDER=mullvad
      - VPN_TYPE=wireguard
      - WIREGUARD_PRIVATE_KEY=MG4gpbUdlMbKorP/Fn/1PABp0bT1d6Vey6k3hDlwNkc=
      - WIREGUARD_ADDRESSES=10.66.24.46/32
      - TZ=America/Phoenix
      - UPDATER_PERIOD=24h
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    network_mode: service:gluetun
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Phoenix
      - WEBUI_PORT=8085
    volumes:
      - /docker/arr-stack/qbittorrent/:/config
      - /mnt/NASMedia/Torrents/:/data/torrents
    restart: always
  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    network_mode: container:gluetun
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Etc/UTC
    volumes:
      - /docker/arr-stack/sonarr/data:/config
      - /mnt/NASMedia/:/data
    restart: unless-stopped
  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    network_mode: service:gluetun
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Phoenix
    volumes:
      - /docker/arr-stack/radarr/data:/config
      - /mnt/NASMedia/:/data

    restart: unless-stopped
  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    network_mode: service:gluetun
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Etc/UTC
    volumes:
      - /docker/arr-stack/prowlarr/data:/config
    restart: unless-stopped
  overseerr:
    image: sctx/overseerr:latest
    container_name: overseerr
    network_mode: service:gluetun
    environment:
      - LOG_LEVEL=debug
      - TZ=America/Phoenix
    volumes:
      - /docker/arr-stack/overseerr:/app/config
    restart: unless-stopped

  recyclarr:
    image: ghcr.io/recyclarr/recyclarr:latest
    container_name: recyclarr
    user: 1000:1000
    network_mode: service:gluetun
    volumes:
      - /docker/arr-stack/recyclarr/config:/config
    environment:
      - TZ=America/Phoenix
